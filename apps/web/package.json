{
  "name": "@guilloche/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run validate:env && vite build",
    "build:skip-env-check": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . --ignore-path ../../.prettierignore && eslint .",
    "lint:fix": "prettier --write . --ignore-path ../../.prettierignore && eslint . --fix",
    "lint:staged": "lint-staged",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:changed": "svelte-kit sync && vitest run --changed HEAD~1 --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen localhost:5173",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:ci": "playwright test --project=chromium --project=firefox",
    "clean": "rm -rf .svelte-kit build node_modules/.vite stats.html playwright-report test-results",
    "prepare": "cd ../.. && git config core.hooksPath apps/web/.husky",
    "commitlint": "commitlint --edit",
    "validate:env": "npx tsx scripts/validate-env.ts",
    "validate:env:strict": "npx tsx scripts/validate-env.ts --strict"
  },
  "dependencies": {
    "@guilloche/core": "workspace:*",
    "@guilloche/shared": "workspace:*",
    "@sentry/sveltekit": "^7.100.0",
    "@stripe/stripe-js": "^3.0.0",
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.42.0",
    "dompurify": "^3.4.12",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "stripe": "^14.0.0",
    "svelte-i18n": "^4.0.1",
    "web-vitals": "^3.5.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240314.0",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.42.0",
    "@sveltejs/adapter-cloudflare": "^4.2.0",
    "@sveltejs/kit": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/svelte": "^4.1.0",
    "autoprefixer": "^10.4.18",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-svelte": "^2.35.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.35",
    "prettier": "^3.2.0",
    "prettier-plugin-svelte": "^3.2.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "svelte": "^4.2.12",
    "svelte-check": "^3.6.7",
    "tailwindcss": "^3.4.1",
    "tslib": "^2.6.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^7.5.0",
    "vite": "^5.1.6",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^1.3.0"
  }
}
