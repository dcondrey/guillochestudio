{
  "name": "@guilloche/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run validate:env && vite build",
    "build:skip-env-check": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . --ignore-path ../../.prettierignore && eslint .",
    "lint:fix": "prettier --write . --ignore-path ../../.prettierignore && eslint . --fix",
    "lint:staged": "lint-staged",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:changed": "svelte-kit sync && vitest run --changed HEAD~1 --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen localhost:5173",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:ci": "playwright test --project=chromium --project=firefox",
    "clean": "rm -rf .svelte-kit build node_modules/.vite stats.html playwright-report test-results",
    "prepare": "cd ../.. && git config core.hooksPath apps/web/.husky",
    "commitlint": "commitlint --edit",
    "validate:env": "npx tsx scripts/validate-env.ts",
    "validate:env:strict": "npx tsx scripts/validate-env.ts --strict"
  },
  "dependencies": {
    "@guilloche/core": "workspace:*",
    "@guilloche/shared": "workspace:*",
    "@sentry/sveltekit": "^7.120.4",
    "@stripe/stripe-js": "^3.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "stripe": "^14.25.0",
    "svelte-i18n": "^4.0.1",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-cloudflare": "^4.9.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "^4.2.3",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte": "^4.2.20",
    "svelte-check": "^3.8.6",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.4.21",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^1.6.1"
  }
}
