# =============================================================================
# Guilloche Web App - Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in the values
# NEVER commit .env to version control - it contains secrets!
#
# For local development:
#   1. Copy this file: cp .env.example .env
#   2. Fill in the values below
#   3. Start the dev server: pnpm dev
#
# Environment validation is performed at startup. The app will fail to start
# if required variables are missing or invalid.
#
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Public URL for the Supabase project (exposed to browser)
# Format: https://<project-id>.supabase.co
# Validation: Must be a valid HTTPS URL
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key for client-side authentication (exposed to browser)
# This key is safe to expose - it has limited permissions based on RLS policies
# Validation: Must be a valid JWT (starts with "eyJ")
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key for server-side operations (NEVER expose to browser!)
# This key bypasses RLS - use only in server-side code
# Validation: Must be a valid JWT (starts with "eyJ")
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# For Supabase CLI deployments (optional)
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ACCESS_TOKEN=your-access-token

# -----------------------------------------------------------------------------
# STRIPE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Get these from your Stripe dashboard:
# https://dashboard.stripe.com/apikeys

# Publishable key for client-side Stripe (exposed to browser)
# Use pk_test_* for development, pk_live_* for production
# Validation: Must start with "pk_test_" or "pk_live_"
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key for server-side Stripe operations (NEVER expose to browser!)
# Use sk_test_* for development, sk_live_* for production
# Validation: Must start with "sk_test_" or "sk_live_"
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret for verifying Stripe webhook events
# Get this from: https://dashboard.stripe.com/webhooks
# Validation: Must start with "whsec_"
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# STRIPE PRICE IDS (Required)
# -----------------------------------------------------------------------------
# Create these products and prices in your Stripe dashboard:
# https://dashboard.stripe.com/products
#
# All price IDs must start with "price_"

# Pro Plan ($12/month or $99/year)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Enterprise Plan ($49/month or $399/year)
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# For Stripe Connect (marketplace payouts) - optional
# STRIPE_CONNECT_CLIENT_ID=ca_xxx

# -----------------------------------------------------------------------------
# APP CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# Application URL (used for redirects and canonical URLs)
# Default: http://localhost:5173 for development
PUBLIC_APP_URL=http://localhost:5173

# Application metadata
# ENVIRONMENT=development
# APP_NAME=Guilloche Studio
# API_VERSION=v1

# -----------------------------------------------------------------------------
# LOGGING & MONITORING (Optional)
# -----------------------------------------------------------------------------

# Log level: debug | info | warn | error
# Default: info
# LOG_LEVEL=info

# Sentry DSN for error tracking
# Get from: https://sentry.io
# SENTRY_DSN=https://...@sentry.io/...

# Plausible Analytics (privacy-friendly)
# PUBLIC_PLAUSIBLE_DOMAIN=guillochestudio.com

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------

# Enable AI-powered features (set to "true" or "1" to enable)
# Default: false
# ENABLE_AI_FEATURES=false

# Enable rate limiting (set to "false" or "0" to disable)
# Default: true
# RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# CLOUDFLARE CONFIGURATION (Optional - for production deployment)
# -----------------------------------------------------------------------------
# Get these from: https://dash.cloudflare.com/YOUR_ACCOUNT_ID

# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
# CLOUDFLARE_ZONE_ID=your-zone-id

# Cloudflare KV Namespace IDs (created via wrangler)
# Run: npx wrangler kv:namespace create PATTERN_CACHE
# KV_PATTERN_CACHE_ID=your-kv-id
# KV_PATTERN_CACHE_PREVIEW_ID=your-preview-kv-id

# Cloudflare R2 Bucket (created via wrangler)
# Run: npx wrangler r2 bucket create guilloche-assets
# R2_BUCKET_NAME=guilloche-assets
# R2_BUCKET_PREVIEW_NAME=guilloche-assets-preview

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------

# Enable verbose logging
# DEBUG=true

# Skip WASM loading (use JS fallback)
# FORCE_JS_ENGINE=true

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# For Cloudflare Pages:
#   1. Go to your Pages project settings
#   2. Navigate to Settings > Environment Variables
#   3. Add all required variables above
#   4. Use different values for Preview vs Production environments
#
# Security Best Practices:
#   - Use Stripe test keys (pk_test_*, sk_test_*) in development/staging
#   - Use Stripe live keys (pk_live_*, sk_live_*) only in production
#   - Never commit .env files to version control
#   - Rotate secrets regularly
#   - Use different Supabase projects for development and production
#
# Validation:
#   - Environment variables are validated at server startup
#   - The app will fail to start if required variables are missing
#   - Clear error messages indicate which variables are missing/invalid
#   - Build validation can be added via: pnpm run validate:env
#
# =============================================================================
