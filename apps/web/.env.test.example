# Playwright E2E Test Environment Variables
# Copy this file to .env.test and fill in the values

# Test user credentials (used for authenticated tests)
# These should be for a real test account in your Supabase project
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your-test-password

# Base URL for tests (default is localhost:5173 for dev, localhost:4173 for preview)
# PLAYWRIGHT_BASE_URL=http://localhost:5173

# Supabase configuration (required for the app to work)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe configuration (required for payment features)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
